// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  mobile           String   @unique
  email            String?  // optional, for newsletters
  role             String   @default("CUSTOMER") // CUSTOMER, STAFF, ADMIN
  marketingConsent Boolean  @default(true) // newsletters, promotions via Email, SMS, WhatsApp
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  bookings      Booking[]
  conversations WhatsAppConversation[]
}

// OTP for mobile login/signup; expires in 10 min
model OtpRequest {
  id        String   @id @default(cuid())
  mobile    String
  otp       String   // 4-digit; in production consider hashing
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([mobile, expiresAt])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  imageUrl     String?
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  subcategories SubCategory[]
  services      Service[]
}

model SubCategory {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  services Service[]
  
  @@unique([categoryId, slug])
}

model Service {
  id             String       @id @default(cuid())
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId  String?
  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  name           String
  description String?
  price       Float
  duration    Int      // in minutes
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  bookingServices BookingService[]
}

model Location {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  address            String?
  mobile             String?   // Contact number for this location (shown on bill)
  imageUrl           String?   // Image for this location (shown on bill)
  isActive           Boolean   @default(true)
  businessHoursJson  String?   // JSON: [{ dayOfWeek: 0-6, isOpen: bool, openTime?: "09:00", closeTime?: "18:00" }]
  closedDatesJson    String?   // JSON: ["2025-01-01", "2025-12-25"] - specific dates closed (festivals, holidays, etc.)
  staffBookingNotifyPhones String? // JSON array of 10-digit mobiles — WhatsApp booking alerts for this location only
  concurrentSlots    Int       @default(1) // Max simultaneous bookings at this location
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  bookings Booking[]
}

model Booking {
  id              String    @id @default(cuid())
  locationId      String?   // Required for new bookings; null for legacy
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime
  timeSlot        String   // e.g., "10:00", "11:00"
  durationMinutes Int      @default(30) // Total service duration at booking time (blocks slots until start + duration)
  groupSize       Int      @default(1)  // Number of people in this group booking
  status          String   @default("BOOKED") // BOOKED, COMPLETED, CANCELLED
  notes           String?
  token           String   @unique // Booking confirmation token
  billNo          String?  // Serial bill number (e.g. BILL-000001), assigned on first invoice generation
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  services BookingService[]
  payment  Payment?
}

// Single row (id=1) for atomic bill number sequence
model BillSequence {
  id       Int @id @default(1)
  lastNo   Int @default(0)
}

model BookingService {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  price       Float    // Total price at time of booking (unit price × quantity)
  quantity    Int      @default(1) // Number of units
  personIndex Int      @default(0) // Which person in the group (0-based)

  createdAt DateTime @default(now())

  @@unique([bookingId, serviceId, personIndex])
}

model Payment {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id])
  amount           Float    // Initial payment amount (advance or full) requested
  totalAmount      Float    @default(0) // Total booking value (sum of services)
  amountPaid       Float    @default(0)  // Total paid so far (online + cash)
  onlineAmount     Float    @default(0)  // Paid via gateway
  cashAmount       Float    @default(0)  // Paid at salon by cash
  paymentType      String   // FULL, ADVANCE
  paymentStatus    String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  gatewayReference String?  // PhonePe transaction ID
  gatewayResponse  String?  // Full gateway response JSON
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── WhatsApp Unified Chat ───────────────────────────────────────────────────

// One conversation per customer mobile number.
// Shared inbox for incoming, agent, and system messages.
model WhatsAppConversation {
  id                 String    @id @default(cuid())
  mobile             String    @unique  // E.164 without + (e.g. 919876543210)
  customerName       String?
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  isResolved         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages WhatsAppMessage[]

  @@index([lastMessageAt(sort: Desc)])
}

// Every message (inbound or outbound) stored here for the unified timeline.
model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  waMessageId    String?  @unique  // wamid.xxx — from WhatsApp API (null until sent)
  direction      String   // "inbound" | "outbound"
  senderType     String   // "user" | "agent" | "system"
  body           String
  messageType    String   @default("text") // text | image | document | audio | video | sticker

  // Delivery status (outbound only)
  status         String   @default("pending") // pending | sent | delivered | read | failed | received

  // Optional metadata for system messages
  templateName   String?
  refType        String?  // "booking" | "payment" | "otp" | "crm"
  refId          String?  // bookingId / paymentId etc.

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([waMessageId])
}

// Home page short videos (reels-style carousel)
model HomeVideo {
  id         String   @id @default(cuid())
  videoUrl   String
  title      String?
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Singleton: one row (id=1). Admin customizations: brand name, menu label, hero banner, gallery images.
model SiteCustomization {
  id                  Int      @id @default(1)
  brandName           String   @default("Salon")
  menuLabel           String   @default("Services")
  heroBannerImageUrl  String?  // Single image URL for hero banner (30% height); replaces video
  heroVideoUrls       String?  // JSON array (legacy / unused when heroBannerImageUrl set)
  galleryImageUrls    String?  // JSON array of URL strings (max 5)
  invoiceWebsite      String?  // Website shown on tax invoice (e.g. shahnazsalonsasaram.com)
  invoiceGst          String?  // GSTIN - Goods and Services Tax Identification Number
  invoiceUpiId        String?  // UPI ID for payment QR on invoice
  invoiceTerms        String?  // Terms & conditions on invoice (e.g. "Goods once sold will not be taken back")
  invoiceSignatureUrl String?  // Signature image shown in invoice signature box
  facebookUrl         String?  // Facebook profile/page URL for footer
  instagramUrl        String?  // Instagram profile URL for footer
  paymentConfigJson   String?  // JSON: PaymentConfig (see lib/paymentConfig.ts)
  updatedAt           DateTime @updatedAt
}
